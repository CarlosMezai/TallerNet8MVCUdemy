@model Models.BlogCore.ViewModels.ArticuloVM


@{
    ViewData["Title"] = "Editar Articulo";
}
<br />
<br />
<h3 class="text-center">Editar artículo</h3>
<form method="POST" asp-action="Edit" enctype="multipart/form-data">

    <!--Se envía el ID del artículo como un campo oculto-->
    <input type="hidden" asp-for="Articulo.Id" />

    <div class="row px-2  border">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="col-8  mt-4">
            <div class="form-group row">
                <div class="col-4">
                    <label asp-for="Articulo.Nombre"></label>
                </div>
                <div class="col-8">
                    <input asp-for="Articulo.Nombre" class="form-control" placeholder="Ingresa el nombre" />
                    <span asp-validation-for="Articulo.Nombre" class="text-danger"></span>
                </div>
            </div>
            <br />
            <div class="form-group row">
                <div class="col-4">
                    <label asp-for="Articulo.Descripcion"></label>
                </div>
                <div class="col-8">
                    <textarea asp-for="Articulo.Descripcion" class="form-control" style="height: 330px"></textarea>
                    <span asp-validation-for="Articulo.Descripcion" class="text-danger"></span>
                </div>
            </div>
            <br />
            <div class="form-group row">
                <div class="col-4">
                    <label asp-for="Articulo.Categoria">Categoría</label>
                </div>
                <div class="col-8">
                    @Html.DropDownListFor(model => model.Articulo.CategoriaId, Model.ListaCategorias,
                    "-Por favor seleccione una categoria-", new { @class = "form-control" })
                    <span asp-validation-for="Articulo.CategoriaId" class="text-danger"></span>
                </div>
            </div>

            <br />
        
            <div class="form-group row">
                <div class="col-4">
                    <label "Imagen">Imagen</label>
                </div>
                <div class="col-8">
                    <input asp-for="Imagen"  type="file" id="subidaArchivo" class="form-control" />
                    <input type="hidden" asp-for="Articulo.Urlmagen"/>
                    <span asp-validation-for="Articulo.Urlmagen" class="text-danger"></span>
                </div>
            </div>

            <br />
            <div class="row">
                <div class="col">
                    <button type="submit" class="btn btn-primary form-control">Editar Artículo</button>

                </div>
                &nbsp;
                <div class="col">
                    <a asp-action="Index" class="btn btn-success form-control">Volver a la lista</a>
                </div>
            </div>
        </div>

        <div class="col-4" pt-3>
            <img src="@Model.Articulo.Urlmagen" width="300px" style="border-radius:5px; border:1px solid #bbb9b9" />

        </div>

    </div>
</form>

